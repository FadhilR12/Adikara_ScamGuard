# PRD Lampiran E
PORT=4000
DATABASE_PATH=./data/scamguard.db
UPLOAD_DIR=./uploads
# Pisahkan dengan koma. chrome-extension://<EXTENSION_ID> untuk produksi.
CORS_ORIGINS=http://localhost:3000
# true = izinkan semua origin chrome-extension:// (praktis saat pengembangan)
ALLOW_ANY_EXTENSION=true
MAX_UPLOAD_MB=10
RULES_VERSION=2026.10.28-1
