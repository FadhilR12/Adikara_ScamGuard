{
  "name": "scamguard",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint:copy": "node scripts/lint-copy.mjs",
    "dev:api": "pnpm --filter @scamguard/api dev",
    "dev:web": "pnpm --filter @scamguard/web dev",
    "dev:ext": "pnpm --filter @scamguard/extension dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
